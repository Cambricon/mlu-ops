#include "box_overlap_bev.h"
#include "box_overlap_bev_utils.h"

#include "core/logging.h"
#include "kernels/debug.h"
#include "kernels/kernel.h"

template <typename T>
__mlu_global__ void MLUUnion1BoxOverlapBevKernel(const T *boxes1,
                                                 const T *boxes2, T *overlaps,
                                                 const int32_t num_boxes1,
                                                 const int32_t num_boxes2) {
  // At first, judge current mlu core deal boxes range
  //
  // For multi-core partition strategy:
  // Each mlu core does different boxes1 range, and all boxes2 with whole loop.
  // TODO(perf): Further more, when num_boxes2 >> num_boxes1, and num_boxes1
  //             is small enough that not all mlu cores do effective works,
  //             should adjust job partition strategy to optimize,
  //             different mlu cores in each cluster, also partition on boxes2,
  //             to improve efficiency.
  // Job partition graph
  //
  //  |    Cluster 1    |    Cluster 2    |    Cluster ...  |  Cluster X  |
  //  |Core 0|...|Core X|  \                  ...                         |
  //  |                        \
  //  |                            \
  //  |                                \
  //  | n=n0~n1, m=m0~m1| n=n1~n2, m=m0~m1|...|
  //  |     Block       |  Block job is also supported, because not using SM

  // For mlu core loop algorithm:
  //  load N and M, M is large, N broadcast 1x7 boxes data once, loop N onchip;
  //  loop N offchip, reuse area2 result onchip;
  //  loop M offchip, compute area2, trans, restore N offchip offset back to 0
  //
  // For mlu core computing algorithm:
  // 1. load input boxes1 and boxes2
  // 2. transpose (distinguish MLU arch >= 300)
  // 3. calculate new points and area, set which area < 1e-14 valid_box = false
  // 4. calculate rotated vertices
  // 5. calculate intersection points, set which nums_in <= 2 valid_box = false
  // 6. convex-hull-graham, set which num_convex <= 2 valid_box = false
  // 7. compute polygon area

  // Not use shared memory core
  if (__is_mpu()) {
    return;
  }

  uint32_t num_total = num_boxes1;
  uint32_t num_per_core = FLOOR_ALIGN(num_total / taskDim, COMPUTE_COUNT_ALIGN);
  uint32_t rem_for_all = num_total - taskDim * num_per_core;
  // last mlu core does more work
  uint32_t current_core_num =
      num_per_core + (taskId == taskDim - 1) * rem_for_all;
  uint32_t current_box1_offset = taskId * num_per_core * PCDET_SINGLE_BOX_DIM;
  uint32_t current_box2_offset;
  uint32_t current_overlaps_offset;

  MLULOG("taskId             : %d\n", taskId);
  MLULOG("taskDim            : %d\n", taskDim);
  MLULOG("num_total          : %d\n", num_total);
  MLULOG("num_per_core       : %d\n", num_per_core);
  MLULOG("rem_for_all        : %d\n", rem_for_all);
  MLULOG("current_core_num   : %d\n", current_core_num);
  MLULOG("current_box1_offset: %d\n", current_box1_offset);

  current_box2_offset = 0;
  current_overlaps_offset = taskId * num_per_core * num_boxes2;
  MLULOG("current_box2_offset: %d\n", current_box2_offset);
  MLULOG("current_overlaps_offset: %d\n", current_overlaps_offset);
  MLUUnion1BoxOverlapBevUtils(boxes1 + current_box1_offset, boxes2,
                              overlaps + current_overlaps_offset,
                              current_core_num, num_boxes2);
}

mluOpStatus_t MLUOP_WIN_API KernelBoxOverlapBev(
    cnrtDim3_t k_dim, cnrtFunctionType_t k_type, cnrtQueue_t queue,
    mluOpDataType_t d_type, const void *boxes1, const void *boxes2,
    void *overlaps, const int num_boxes1, const int num_boxes2) {
  // Only float data type is supported
  KERNEL_CHECK(MLUUnion1BoxOverlapBevKernel<float><<<k_dim, k_type, queue>>>(
      (float *)boxes1, (float *)boxes2, (float *)overlaps, num_boxes1,
      num_boxes2));
  return MLUOP_STATUS_SUCCESS;
}
